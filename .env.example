# ---- Database (PostgreSQL) ----
# App runtime connection (pooled if your provider offers one).
DATABASE_URL="postgresql://user:password@host:5432/lms?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Optional:
# in Docker/CranL it falls back to DATABASE_URL when unset. Set it when your
# provider separates pooled vs direct (e.g. Supabase PgBouncer :6543 vs :5432).
DIRECT_URL="postgresql://user:password@host:5432/lms?schema=public"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-char-random-string"
# Optional. Leave unset behind a platform proxy (trustHost is enabled).
# AUTH_URL="https://your-app.cranl.net"

# ---- Optional OAuth (Google) ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Container startup (Docker/CranL) ----
# Set to "true" to seed demo data on first boot (admin/instructor/student).
# SEED_ON_START="true"
