# Database (PostgreSQL 16)
# App runtime uses the (optionally pooled) DATABASE_URL. Prisma migrations use
# DIRECT_URL — set it to a direct connection, or the same value locally.
# On Vercel+Supabase these are auto-derived from POSTGRES_* (see src/config/env.ts).
DATABASE_URL="postgresql://lms:lms@127.0.0.1:5432/lms?schema=public"
DIRECT_URL="postgresql://lms:lms@127.0.0.1:5432/lms?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Base URL of the app (used by Auth.js callbacks)
AUTH_URL="http://localhost:3000"

# Optional OAuth provider (GitHub). Leave blank to disable.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# File uploads are stored in the database (no external storage needed).
# MAX_UPLOAD_MB caps size; DB-stored files are additionally capped at 5MB.

# (Legacy S3 fields — unused by the current upload flow, kept for reference.)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="lms-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="http://127.0.0.1:9000/lms-uploads"

# Uploads
MAX_UPLOAD_MB="50"

# Node env
NODE_ENV="development"
